# Empêche l'accès direct aux fichiers de configuration et de données.
<FilesMatch "\.(sql|md|env)$">
  Require all denied
</FilesMatch>
<FilesMatch "^config\.php$">
  # config.php doit être exécuté (return array), jamais servi tel quel — PHP s'en charge déjà,
  # cette règle est une protection supplémentaire si le moteur PHP venait à être désactivé.
  Require all denied
</FilesMatch>
Options -Indexes
