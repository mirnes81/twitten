# Empêche l'accès direct aux fichiers de configuration et de données.
# Compatible Apache 2.2 (mod_access) et 2.4 (mod_authz_core), pour éviter
# une erreur 500 si le module attendu n'est pas chargé sur l'hébergement.
<IfModule mod_authz_core.c>
  <FilesMatch "\.(sql|md|env)$">
    Require all denied
  </FilesMatch>
  <FilesMatch "^config\.php$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "\.(sql|md|env)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
  <FilesMatch "^config\.php$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
Options -Indexes
